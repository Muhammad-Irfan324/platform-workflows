######################################################################
# CI Tool Versions
######################################################################
#
# Versions for the tooling this repository's OWN workflows install,
# read via actions/load-tool-versions.
#
# Scope is deliberately narrow. Only list a value here once something
# actually reads it — an entry nobody consumes looks like a control and
# is not one, so bumping it silently does nothing.
#
# TERRAFORM IS DELIBERATELY NOT LISTED HERE.
#
# Terraform writes terraform_version into remote state and refuses to
# operate on state written by a newer minor, so the Terraform version is
# a property of each deployment's state — not something this repository
# may impose. terraform-plan and terraform-apply take it from the
# calling repo; terraform-module-ci carries its own default, because a
# module under test has no state.
#
# NOTHING BUMPS THESE AUTOMATICALLY.
#
# Dependabot reads `uses:` refs and package manifests. It has no idea what
# TFLint or terraform-docs are, so no ecosystem covers this file and these
# pins will sit here until a person changes them. Check them quarterly:
#
#   tflint          https://github.com/terraform-linters/tflint/releases
#   tflint aws      https://github.com/terraform-linters/tflint-ruleset-aws/releases
#   terraform-docs  https://github.com/terraform-docs/terraform-docs/releases
#   actionlint      https://github.com/rhysd/actionlint/releases
#
# The npm side is handled: the semantic-release toolchain lives in
# configs/package.json precisely so Dependabot's npm ecosystem can watch it.
# A scheduled bump job was considered for this file and rejected — four
# slow-moving tools did not justify a custom workflow whose own failure
# mode is silence, which is the problem it would exist to solve.
#
# A *_SHA256 line is the digest of the release asset its *_VERSION names.
# The two are one value in two lines: bump a version without its digest and
# the install step fails the checksum, loudly, in every repo. That failure is
# the control working. Refresh the digest from the release's own checksums
# file, never from the tarball you just downloaded.
#
# Format: KEY=VALUE, one per line. No spaces around '='. No quotes.
######################################################################

# terraform-module-ci
TFLINT_VERSION=v0.64.0
TFLINT_AWS_RULESET_VERSION=0.48.0
TERRAFORM_DOCS_VERSION=v0.24.0
# terraform-docs-v0.24.0.sha256sum
TERRAFORM_DOCS_SHA256=9005daf969de0b50134493a2c00078b49f5f5b39d021cda7c89bf4d4f3d776d3

# release workflows
#
# Must stay a bare major. @semantic-release/changelog@7 and
# @semantic-release/git@11 require node ^22.22.2 || >=24.15, and "22" lets
# setup-node resolve the newest 22.x. Pinning a narrower 22.x below 22.22.2
# fails their engine check at install time.
NODE_VERSION=22

# ci (this repository's own checks)
#
# yamllint is NOT here. pip --require-hashes needs its version and its
# digests to move as one, so both live in configs/yamllint-requirements.txt
# where Dependabot's pip ecosystem rewrites them together.
ACTIONLINT_VERSION=1.7.12
# actionlint_1.7.12_checksums.txt
ACTIONLINT_SHA256=8aca8db96f1b94770f1b0d72b6dddcb1ebb8123cb3712530b08cc387b349a3d8
